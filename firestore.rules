rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == "Nxsbigjez6eBRMiZZdTzHv3oINn1";
    }

    // La agenda móvil es de solo lectura.
    match /eventos_publicos/{eventoId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /eventos_meta/{documentoId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /eventos_cambios/{cambioId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
