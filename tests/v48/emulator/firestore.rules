rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "Nxsbigjez6eBRMiZZdTzHv3oINn1";
    }

    match /eventos_publicos/{documento} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();
    }

    match /eventos_meta/{documento} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();
    }

    match /eventos_cambios/{documento} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();
    }

    match /equipos_autorizados/{deviceId} {
      function ownDevice() {
        return signedIn() && deviceId == request.auth.uid;
      }
      allow create: if ownDevice()
        && request.resource.data.keys().hasOnly(['schema', 'deviceId', 'authUid', 'localDeviceId', 'deviceName', 'platform', 'browser', 'status', 'authorized', 'revoked', 'createdAt', 'clientCreatedAt', 'lastSeenAt', 'clientLastSeenAt'])
        && request.resource.data.schema == 2
        && request.resource.data.deviceId == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.authorized == false
        && request.resource.data.revoked == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time;
      allow get: if isOwner() || ownDevice();
      allow list: if isOwner();
      allow update: if isOwner() || (
        ownDevice() && resource.data.authUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'clientLastSeenAt', 'localUsername', 'localDisplayName'])
        && request.resource.data.lastSeenAt == request.time
      );
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
