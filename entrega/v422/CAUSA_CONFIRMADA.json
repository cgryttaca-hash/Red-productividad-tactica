      "text": "name: Publicar versión aprobada\non:\n  workflow_dispatch:\n    inputs:\n      version:\n        description: Versión que se publicará, por ejemplo 4.0.0\n        required: true\n        type: string\n      approved:\n        description: He revisado pruebas y cambios y autorizo publicar este commit\n        required: true\n        type: boolean\n        default: false\npermissions:\n  contents: read\nconcurrency:\n  group: publicar-eventos\n  cancel-in-progress: false\njobs:\n  prepare:\n    if: inputs.approved == true\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: '22'\n      - uses: pnpm/action-setup@v4\n        with:\n          version: '10.11.0'\n      - run: pnpm install --frozen-lockfile --ignore-scripts\n      - run: node tools/build-release.cjs --version \"$RELEASE_VERSION\"\n        env:\n          RELEASE_VERSION: ${{ inputs.version }}\n      - run: pnpm check\n      - run: pnpm test\n      - run: pnpm exec playwright install --with-deps chromium\n      - run: pnpm test:updates\n      - uses: actions/upload-pages-artifact@v3\n        with:\n          path: dist\n  publish:\n    needs: prepare\n    runs-on: ubuntu-latest\n    permissions:\n      pages: write\n      id-token: write\n    environment:\n      name: production\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: Publicar artefacto verificado\n        id: deployment\n        uses: actions/deploy-pages@v4\n"
